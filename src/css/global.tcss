#request-bar {
    height: 3;
    margin: 1 1;
}

#method-select {
    width: 15;
}

#url-input {
    width: 1fr;
}

#send-btn {
    width: 12;
}

#main-container {
    height: 1fr;
}

.pane {
    width: 1fr;
    height: 1fr;
    border: solid green;
    margin: 0 1;
}

.section-title {
    text-style: bold;
    background: $accent;
    color: $text;
    padding: 0 1;
}

#status-label {
    height: 1;
    margin: 0 1;
    text-style: bold;
}
